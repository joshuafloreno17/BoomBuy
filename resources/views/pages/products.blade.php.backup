            <option value="low">
                Price: Low to High
            </option>

            <option value="high">
                Price: High to Low
            </option>

            <option value="rating">
                Rating: Highest
            </option>

        </select>

    </div>


    <!-- PRODUCTS -->

    <section class="products">

